{
  "schemaVersion": 1,
  "id": "blackannins_statistics",
  "version": "${version}",
  "name": "BlackAnnin's Statistics",
  "description": "本地游戏数据统计：游玩时长、方块破坏/放置、生物击杀、物品使用/拾取等。按 全局/单人(每个存档)/多人(每个服务器) 分类查看，支持多档案、模组内容统计。纯客户端运行，数据只保存在本地，绝不上传。",
  "authors": [
    "BlackAnnin"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.blackannin.statistics.BlackAnninsStatisticsClient"
    ]
  },
  "mixins": [
    {
      "config": "blackannins_statistics.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": ">=26.2 <26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}
